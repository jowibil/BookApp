<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Books and the library database are large personal content. Restoring one
         without the other would show books whose files are missing, so neither is
         copied off-device. Reader preferences may still be restored. -->
    <cloud-backup>
        <exclude domain="file" path="books/" />
        <exclude domain="file" path="covers/" />
        <exclude domain="database" path="bookappp.db" />
        <exclude domain="database" path="bookappp.db-shm" />
        <exclude domain="database" path="bookappp.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="books/" />
        <exclude domain="file" path="covers/" />
        <exclude domain="database" path="bookappp.db" />
        <exclude domain="database" path="bookappp.db-shm" />
        <exclude domain="database" path="bookappp.db-wal" />
    </device-transfer>
</data-extraction-rules>
